{
  "hosting": {
    "public": "apps/web/dist",
    "ignore": ["**/.*", "**/*.map", "index.html"],
    "rewrites": [
      { "source": "/api/**", "run": { "serviceId": "scrbrd-api", "region": "africa-south1" } },
      { "source": "/live/**", "run": { "serviceId": "scrbrd-api", "region": "africa-south1" } },
      { "source": "/scorecard/**", "run": { "serviceId": "scrbrd-api", "region": "africa-south1" } },
      { "source": "/display/**", "run": { "serviceId": "scrbrd-api", "region": "africa-south1" } },
      { "source": "/table/**", "run": { "serviceId": "scrbrd-api", "region": "africa-south1" } },
      { "source": "/fixtures/**", "run": { "serviceId": "scrbrd-api", "region": "africa-south1" } },
      { "source": "/", "destination": "/home.html" },
      { "source": "/privacy", "destination": "/home.html" },
      { "source": "**", "destination": "/app.html" }
    ],
    "headers": [
      { "source": "/sw.js", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
      { "source": "/firebase-messaging-sw.js", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
      { "source": "/public-app.js", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
      { "source": "**/*.html", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
      { "source": "/", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
      { "source": "/privacy", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
      { "source": "/app/**", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
      { "source": "/app", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
      { "source": "/assets/**", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] }
    ]
  }
}
