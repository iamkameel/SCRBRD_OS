{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "mcp__github__merge_pull_request",
      "Bash(gh api -X PUT repos/iamkameel/SCRBRD_OS/pulls/*/merge *)",
      "Bash(gh api -X POST repos/iamkameel/SCRBRD_OS/actions/runs/*/cancel)",
      "Bash(gh api -X POST repos/iamkameel/SCRBRD_OS/actions/runs/*/rerun-failed-jobs)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR:-.}/tools/hooks/guard.mjs\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR:-.}/tools/hooks/guard.mjs\"",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "extraKnownMarketplaces": {
    "egm": {
      "source": {
        "source": "github",
        "repo": "google/elephant-goldfish-model"
      }
    }
  },
  "enabledPlugins": {
    "egm@egm": true
  }
}
