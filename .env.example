# SCRBRD — local environment. Copy to .env; `pnpm dev` loads it for the API and
# Vite reads the VITE_* lines for the client. Nothing here is required for a
# local run: every value below is the default the code already assumes.

# ── Database ──────────────────────────────────────────────────────────────
# THE API connects as the UNPRIVILEGED application role. Row-level security
# does not apply to a table's owner, so server.mjs refuses to start on a
# connection that owns the tables or can bypass RLS — pointing this at the
# owner role is a refused start, not a quiet one.
DATABASE_URL=postgres://scrbrd_app:scrbrd_app@127.0.0.1:5432/scrbrd
#
# MIGRATIONS AND SEEDING (`pnpm db:*`) run as the OWNER, scrbrd/scrbrd — the
# role docker-compose.yml creates. They do NOT read this file: only `pnpm dev`
# loads .env, so the line above never reaches them. If your Postgres is not the
# default one, export the owner URL in the shell for the db:* commands instead:
#   DATABASE_URL=postgres://scrbrd:scrbrd@host:5432/scrbrd pnpm db:reset

# ── API ───────────────────────────────────────────────────────────────────
PORT=8787
WEB_ORIGIN=http://localhost:5173
# Sessions are signed with this. Unset → an ephemeral secret is minted at boot
# and every token dies on restart, which is fine for development.
# SESSION_SECRET=change-me-in-any-deployment
# `pnpm dev` sets these two itself; they are here so a direct `node
# services/api/server.mjs` can be told the same. Dev login is refused
# unconditionally when NODE_ENV=production.
NODE_ENV=development
ALLOW_DEV_LOGIN=1

# ── Client ────────────────────────────────────────────────────────────────
VITE_API_BASE=http://localhost:8787
# The PUBLIC half of the web-push VAPID pair. Optional; without it the Alerts
# tab says push is not configured for this deployment, which is true.
# VITE_FCM_VAPID_KEY=

# ── Push delivery (optional, server) ──────────────────────────────────────
# Without these the fan-out route answers 503 push_not_configured and writes
# no delivery log — a log of pretend sends reads later as evidence a parent was
# told. In development, PUSH_TRANSPORT=echo records sends in memory instead.
# FCM_PROJECT_ID=scrbrd-os
# FCM_ACCESS_TOKEN=
# PUSH_TRANSPORT=echo
